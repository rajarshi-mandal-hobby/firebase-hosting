{
    "name": "temp-vite",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview",
        "emulators": "firebase emulators:start --project demo-rajarshi-mess",
        "emulators:kill": "powershell -ExecutionPolicy Bypass -File ./emulators-kill.ps1",
        "emulators:seed": "curl -X DELETE \"http://127.0.0.1:8080/emulator/v1/projects/demo-rajarshi-mess/databases/(default)/documents\" && vite-node emulators-seed.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@mantine/core": "^9.2.1",
        "@mantine/dates": "^9.2.1",
        "@mantine/form": "^9.2.1",
        "@mantine/hooks": "^9.2.1",
        "@mantine/modals": "^9.2.1",
        "@mantine/notifications": "^9.2.1",
        "dayjs": "^1.11.20",
        "firebase": "^12.13.0",
        "mantine-form-valibot-resolver": "^3.0.1",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-router": "^7.15.1",
        "valibot": "^1.4.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.8.3",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/babel__core": "^7.20.5",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.4.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.6.0",
        "postcss": "^8.5.15",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.14",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.7"
    }
}
